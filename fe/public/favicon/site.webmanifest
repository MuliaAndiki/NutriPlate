{
  "name": "NutriPlate - Pemantauan Gizi Anak",
  "short_name": "NutriPlate",
  "description": "Sistem Integratif Berbasis IoT & PWA untuk Pemantauan Gizi Anak",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#10B981",
  "background_color": "#ffffff",
  "categories": ["health", "productivity"],
  "screenshots": [
    {
      "src": "/images/logo.svg",
      "sizes": "540x720",
      "type": "image/svg",
      "form_factor": "narrow"
    },
    {
      "src": "/images/logo.svg",
      "sizes": "1280x720",
      "type": "image/svg",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "/favicon/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/android-chrome-maskable-192x192.png",
      "sizes": "192x192",
